# --- Database (Neon, DI SVILUPPO) ---
# Un solo file .env per tutto: `npm run dev` E `npm run test:e2e` lo leggono
# entrambi (non esiste più un .env.test separato — vedi CLAUDE.md, changelog
# 2026-09-07). Usa un database TUO, diverso da quello di produzione — non le
# stesse credenziali che Netlify inietta in produzione. Il modo più semplice
# e gratuito: crea un progetto (o un branch) dedicato su neon.tech e incolla
# qui la sua stringa di connessione. Vedi il README, sezione
# "Environment variables".
#
# In PRODUZIONE non serve toccare questo file: una volta collegato Netlify DB
# al sito, Netlify inietta da solo NETLIFY_DATABASE_URL (pooled, usata
# dall'app) e NETLIFY_DATABASE_URL_UNPOOLED (diretta, usata dalle migrazioni).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Connessione diretta (senza pgbouncer davanti), usata solo da drizzle-kit
# per applicare le migrazioni. Se il tuo provider ne offre solo una, lasciala
# vuota: drizzle.config.ts ricade su DATABASE_URL.
DATABASE_URL_UNPOOLED=""

RESEND_API_KEY=""
MAIL_FROM=""

# --- Better Auth ---
# openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-32-bytes-min"
BETTER_AUTH_URL="http://localhost:5173"
PUBLIC_APP_URL="http://localhost:5173"

# --- Google OAuth (console.cloud.google.com) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Apple Sign In (developer.apple.com) ---
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
APPLE_APP_BUNDLE_IDENTIFIER=""
