{
	"name": "pillole",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node --experimental-strip-types --env-file-if-exists=.env scripts/seed.ts",
		"test:e2e": "node --env-file=.env.test node_modules/@playwright/test/cli.js test",
		"test:e2e:report": "node node_modules/@playwright/test/cli.js show-report test-results/html-report",
		"test:e2e:docs": "node --experimental-strip-types scripts/generate-test-report.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.4",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"pg": "^8.23.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.19.0",
		"svelte-check": "^4.1.4",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource-variable/nunito": "^5.3.0",
		"@neondatabase/serverless": "^1.1.0",
		"@opentelemetry/api": "^1.9.1",
		"better-auth": "^1.1.15",
		"drizzle-orm": "^0.45.2",
		"katex": "^0.18.5",
		"zod": "^4.5.4"
	},
	"allowScripts": {
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true
	},
	"overrides": {
		"cookie": "^0.7.2"
	}
}
