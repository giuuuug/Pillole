{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM"],
		"types": ["node", "@playwright/test"],
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"noEmit": true
	},
	"include": ["**/*.ts", "../scripts/generate-test-report.ts", "../playwright.config.ts"]
}
